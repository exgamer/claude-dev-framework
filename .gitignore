# IDE / ОС
.idea/
.vscode/
*.swp
.DS_Store

# Python (tools/sdk-ref/phpref.py)
__pycache__/
*.pyc

# Временные выгрузки генераторов справочников (сами справочники в stacks/*/reference/ — коммитятся)
tools/sdk-ref/out/
tmp/

# Граф правил (tools/graph): корпус — копия, собирается заново; чанки агентов — временные, с абсолютными путями
tools/graph/corpus/
tools/graph/graphify-out/.chunk_*
tools/graph/graphify-out/.graphify_chunk_*

# Стенд PHP-эталона: путь к auth.json с токеном — локальный
tools/php-check/.auth-path

# PHP-контейнеры разработчика (tools/lint/php_container.py): у каждого свои имена
tools/lint/.php-containers.json

# Реальные проекты разработчика для прогона анализаторов (tools/lint/real_projects.py): пути — свои
tools/lint/.real-projects.json

# Локальные настройки Claude Code
.claude/settings.json
.claude/settings.local.json

# Бинарник анализатора после ручного `go build` (lint.py собирает свой в кеш вне репозитория)
tools/lint/gocheck/gocheck

# Метка продолжения команды после /clear (tools/resume/resume.py): у каждого своя
.claude/df-resume.json

# Отметка «тур /dev-intro предложен» (хук tools/resume/resume.py): у каждого своя
.claude/df-intro-shown
