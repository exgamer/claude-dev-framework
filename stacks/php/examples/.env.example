# Фрагмент .env.example приложения: внешние системы эталона (обязательны, таймаут — секунды)
CITY_PARKING_BASE_URL=https://registry.city-parking.example/api/v1
CITY_PARKING_TIMEOUT=3
PARTNER_BILLING_BASE_URL=https://api.partner-billing.example/v2
PARTNER_BILLING_TIMEOUT=5
# Outbox событий о тарифах (обязательны): попыток до failed, пачка повтора, «зависло» через N секунд
OUTBOX_TARIFF_EVENTS_MAX_ATTEMPTS=5
OUTBOX_TARIFF_EVENTS_RETRY_BATCH_SIZE=100
OUTBOX_TARIFF_EVENTS_RETRY_STALE_AFTER_SECONDS=300
# Подпись машинного вызова Integration (обязательны): секрет, окно времени и срок жизни nonce — секунды
INTEGRATION_SIGNATURE_SECRET=
INTEGRATION_SIGNATURE_TOLERANCE_SECONDS=300
INTEGRATION_SIGNATURE_NONCE_TTL_SECONDS=600
