# Приложение (gosdk-core)
APP_NAME=parking-service
APP_ENV=local
APP_VERSION=1.0
CONTAINER_NAME=
TIMEZONE=Asia/Almaty
LOG_LEVEL=DEBUG

# HTTP (gosdk-http-core); таймауты — в секундах
SERVER_ADDRESS=0.0.0.0:8090
SWAGGER_PREFIX=swagger
HANDLER_TIMEOUT=30
SERVER_READ_TIMEOUT_SEC=
SERVER_READ_HEADER_TIMEOUT_SEC=
SERVER_WRITE_TIMEOUT_SEC=
SERVER_IDLE_TIMEOUT_SEC=
# Через запятую или *; пусто — CORS-заголовки не ставятся
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Sentry (gosdk-sentry-core); пусто — ошибки не отправляются
SENTRY_DSN=

# Postgres (gosdk-postgres-core)
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=parking
POSTGRES_DB_USER=
POSTGRES_DB_PASSWORD=
POSTGRES_DB_MAX_OPEN_CONNECTIONS=100
POSTGRES_DB_MAX_IDLE_CONNECTIONS=10
POSTGRES_DB_LOGGING=false
POSTGRES_DB_LOG_LEVEL=
# Медленный запрос, секунды
POSTGRES_DB_THRESHOLD=

# Redis (gosdk-redis-core)
REDIS_HOST=localhost:6379
REDIS_DB=0
REDIS_USER=
REDIS_PASSWORD=
REDIS_POOL_SIZE=
REDIS_IDLE_TIMEOUT=
REDIS_MAX_CONN_LIFETIME=
REDIS_DIAL_TIMEOUT_MS=
REDIS_READ_TIMEOUT_MS=
REDIS_WRITE_TIMEOUT_MS=
REDIS_MAX_RETRIES=
REDIS_CONTEXT_TIMEOUT_ENABLED=

# RabbitMQ (gosdk-rabbit-core)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Модуль тарифов: внешние системы, обязательны; таймауты — секунды
CITYPARKING_BASE_URL=http://localhost:8091
CITYPARKING_TIMEOUT_SECONDS=5
PARTNERBILLING_BASE_URL=http://localhost:8092
PARTNERBILLING_TIMEOUT_SECONDS=5

# Consumer handbook.parking.deactivated: временная ошибка — повтор через retry-очередь (DLX + TTL), обязательны.
# MAX_ATTEMPTS — доставок всего, после последней — фиксация в трекере и ACK; задержка — секунды
TARIFF_PARKING_DEACTIVATED_MAX_ATTEMPTS=5
TARIFF_PARKING_DEACTIVATED_RETRY_DELAY_SECONDS=15

# Outbox событий тарифов (сервис и консоль), обязательны
OUTBOX_TARIFF_EVENT_MAX_ATTEMPTS=5
OUTBOX_TARIFF_EVENT_BATCH_SIZE=100
OUTBOX_TARIFF_EVENT_STALE_AFTER_SECONDS=60

# Аутентификация администратора (JWT RS256 сервиса авторизации, который выпускает токены администраторов), обязательны, кроме JWT_LEEWAY_SECONDS (0 — без допуска)
JWT_PUBLIC_KEY_BASE64=
JWT_GUARD_NAME=admin-api
JWT_LEEWAY_SECONDS=30
ADMIN_AUTH_CACHE_TTL_SECONDS=60

# Машинный вызов партнёра (Api-Key + подпись X-Signature), обязательны; NONCE_TTL ≥ 2×TOLERANCE
PARTNER_API_KEY=
PARTNER_SIGNATURE_SECRET=
PARTNER_SIGNATURE_TOLERANCE_SECONDS=300
PARTNER_SIGNATURE_NONCE_TTL_SECONDS=600
