{"nodes": [{"id": "file_stacks_go_go_sdk_infra_postgres_md", "label": "stacks/go/go-sdk/infra/postgres.md", "file_type": "document", "source_file": "corpus/stacks/go/go-sdk/infra/postgres.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rule_go_postgres_timeout", "label": "\u041a\u0430\u0436\u0434\u044b\u0439 DB-\u0437\u0430\u043f\u0440\u043e\u0441 \u2014 WithTimeout 10 \u0441; \u0443 NewGormPaginatedHelper \u0432\u0441\u0442\u0440\u043e\u0435\u043d (10 \u0441), SetTimeout(n) \u2014 \u0441\u0435\u043a\u0443\u043d\u0434\u0430\u043c\u0438, 10*time.Second \u2014 paginator-timeout-units", "file_type": "document", "source_file": "corpus/stacks/go/go-sdk/infra/postgres.md", "source_location": "\u041f\u0440\u0430\u0432\u0438\u043b\u0430", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rule_go_postgres_tx_rule", "label": "\u0422\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u044f \u0432 Workflow/Command/Service \u2014 \u043f\u0440\u0438 >1 \u043c\u043e\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u0443\u044e\u0449\u0435\u043c \u0437\u0430\u043f\u0440\u043e\u0441\u0435; \u043e\u0434\u0438\u043d \u2014 \u0431\u0435\u0437 \u043d\u0435\u0451, \u043a\u0440\u043e\u043c\u0435 FOR UPDATE/FOR SHARE (O-8)", "file_type": "document", "source_file": "corpus/stacks/go/go-sdk/infra/postgres.md", "source_location": "\u0422\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rule_go_postgres_fn_only_arg_repos", "label": "\u0412\u043d\u0443\u0442\u0440\u0438 fn \u2014 \u0442\u043e\u043b\u044c\u043a\u043e \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0438 \u0438\u0437 \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442\u043e\u0432; \u0441\u0435\u0440\u0432\u0438\u0441/Command \u0438\u043b\u0438 \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0439 \u0438\u0437 \u043f\u043e