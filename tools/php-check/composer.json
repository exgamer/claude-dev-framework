{
    "name": "dev-framework/php-check",
    "description": "Стенд прогона PHP-эталона stacks/php/examples: phpunit + phpstan",
    "type": "project",
    "repositories": [
        {"type": "vcs", "url": "https://git.mpinnovations.kz/mps/packages/core.git"},
        {"type": "vcs", "url": "https://git.mpinnovations.kz/mps/packages/utils.git"},
        {"type": "vcs", "url": "https://git.mpinnovations.kz/mps/packages/elastic-query.git"}
    ],
    "require": {
        "php": ">=8.3",
        "laravel/framework": "^12.0",
        "mps/core": "1.6.0",
        "mps/utils": "2.6.2",
        "zircote/swagger-php": "*"
    },
    "require-dev": {
        "larastan/larastan": "^3.1",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0",
        "phpstan/phpstan-mockery": "^2.0",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\ParkingApp\\": "parking_app/",
            "App\\Http\\": "stub/App/Http/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
